  "default_strategy": {
    "method": "beam_p2",
    "seed": "start",
    "pool": "none",
    "capture": "window14",
    "representation": "direct",
    "board_filter": "near-record",
    "knobs": {
      "W": 20000,
      "DMAX": 600,
      "H": 1,
      "DIV": 0.8,
      "P2": 2,
      "QUOTA": 16,
      "ELITE": 5000,
      "DUAL": 0.75,
      "CHAIN": 1,
      "SEED": 101,
      "NOISE": 2
    }
  },
  "methods": {
    "beam": {
      "runner": "code",
      "about": "acc_beam (T9 finish) + acc_window shortening via run_beam_raw.py; writes one JSON line per row with ac and sac paths",
      "command": [
        "{python}",
        "research/acc/optimality/run_beam_raw.py",
        "{manifest}",
        "{bin}",
        "{t9}",
        "{work}",
        "{knob:W}",
        "{knob:DMAX}",
        "{out}",
        "{targets}"
      ],
      "env": {
        "BEAM_H": "{knob:H}",
        "BEAM_DIV": "{knob:DIV}",
        "BEAM_SEED": "{knob:SEED}",
        "BEAM_NOISE": "{knob:NOISE}"
      },
      "needs": [
        "bin/acc_beam",
        "bin/acc_window",
        "T9.tab"
      ],
      "wall_seconds": 1080
    },
    "window": {
      "runner": "code",
      "about": "acc_window 7-layer BFS window shortening of our current best AC path per row (run_window.py); deterministic",
      "command": [
        "{python}",
        "research/acc/optimality/run_window.py",
        "{bin}/acc_window",
        "{sair}",
        "{work}",
        "{out}",
        "{jobs}"
      ],
      "needs": [
        "bin/acc_window"
      ],
      "needs_best": true,
      "wall_seconds": 1500
    },
    "tail": {
      "runner": "code",
      "about": "exact tail replacement: from each state on our best AC path, capped exact search to the target with the T9 finish (research/acc/optimality/tail_replace.py via adapters/tail_replace_rows.py); deterministic",
      "command": [
        "{python}",
        "tools/acc/upgh/adapters/tail_replace_rows.py",
        "{sair}",
        "{bin}",
        "{t9}",
        "{work}",
        "{jobs}",
        "{out}",
        "{knob:SLACK}",
        "{knob:BUDGET}",
        "{knob:ROW_S}"
      ],
      "needs": [
        "bin/acc_capped",
        "T9.tab"
      ],
      "needs_best": true,
      "wall_seconds": 1500,
      "env": {
        "TAIL_ORDER": "{knob:ORDER}"
      }
    },
    "beam_p2": {
      "runner": "code",
      "about": "P2 dual beam (the team's winning setting: shorter on 7 of 10, never longer, 20-60% faster; METHODS_PLAYBOOK) + window shortening via run_beam_raw.py",
      "command": [
        "{python}",
        "research/acc/optimality/run_beam_raw.py",
        "{manifest}",
        "{bin}",
        "{t9}",
        "{work}",
        "{knob:W}",
        "{knob:DMAX}",
        "{out}",
        "{targets}"
      ],
      "env": {
        "BEAM_H": "{knob:H}",
        "BEAM_DIV": "{knob:DIV}",
        "BEAM_SEED": "{knob:SEED}",
        "BEAM_NOISE": "{knob:NOISE}",
        "BEAM_P2": "{knob:P2}",
        "BEAM_QUOTA": "{knob:QUOTA}",
        "BEAM_ELITE": "{knob:ELITE}",
        "BEAM_DUAL": "{knob:DUAL}",
        "BEAM_CHAIN": "{knob:CHAIN}"
      },
      "needs": [
        "bin/acc_beam",
        "bin/acc_window",
        "T9.tab"
      ],
      "wall_seconds": 2400,
      "rows_per_task": 1
    },
    "yx": {
      "runner": "code",
      "about": "Stable AC through the (y,x) orientation: exact meet in the middle from late states of our AC twin path to (y,x), then [15,15] (tools/acc/yx_shortcut.py via adapters/yx_rows.py); deterministic; SAC rows only",
      "command": [
        "{python}",
        "tools/acc/upgh/adapters/yx_rows.py",
        "{sair}",
        "{jobs}",
        "{targets}",
        "{out}",
        "{knob:ROW_S}"
      ],
      "needs": [],
      "needs_ac_twin": true,
      "sac_only": true,
      "wall_seconds": 1200
    },
    "beam_free": {
      "runner": "code",
      "about": "P2 dual beam with free depth (record + FREE): any road first, shorten later (team pipeline for rows with no path)",
      "command": [
        "{python}",
        "research/acc/optimality/run_beam_raw.py",
        "{manifest}",
        "{bin}",
        "{t9}",
        "{work}",
        "{knob:W}",
        "{knob:DMAX}",
        "{out}",
        "{targets}"
      ],
      "env": {
        "BEAM_H": "{knob:H}",
        "BEAM_DIV": "{knob:DIV}",
        "BEAM_SEED": "{knob:SEED}",
        "BEAM_NOISE": "{knob:NOISE}",
        "BEAM_P2": "{knob:P2}",
        "BEAM_QUOTA": "{knob:QUOTA}",
        "BEAM_ELITE": "{knob:ELITE}",
        "BEAM_DUAL": "{knob:DUAL}",
        "BEAM_CHAIN": "{knob:CHAIN}",
        "BEAM_FREE_DMAX": "{knob:FREE}"
      },
      "needs": [
        "bin/acc_beam",
        "bin/acc_window",
        "T9.tab"
      ],
      "wall_seconds": 1800,
      "rows_per_task": 1,
      "needs_nobest": true
    },
    "construction": {
      "runner": "agent",
      "wall_seconds": 3600,
      "about": "agent reasons out a generator path(n) for a family of rows (for example the MS(n,w) doubling chains), checks it on small n, then writes full paths for the board rows; code verifies every line"
    },
    "splice": {
      "runner": "code",
      "about": "cross-road splice: pool our best AC path + every ledger path + every team road for the row, exact radius-R shortcut edges between all pool states, Dijkstra, then acc_beam waypoint restarts and splice again (tools/acc/splice/splice.py via adapters/splice_rows.py). Astra's 22:16Z receipt audit: all five verified improvements of 30 Sep came from saved-road unions",
      "command": [
        "{python}",
        "tools/acc/upgh/adapters/splice_rows.py",
        "{sair}",
        "{bin}",
        "{t9}",
        "{work}",
        "{jobs}",
        "{targets}",
        "{out}",
        "{knob:RADIUS}",
        "{knob:ROUNDS}",
        "{knob:ROW_S}"
      ],
      "needs": [
        "bin/acc_beam",
        "T9.tab"
      ],
      "needs_best": true,
      "wall_seconds": 1500
    }
  },
